<nav class="main-nav">
  <ul class="main-menu">
    {% for menuKey, menuItem in adminMenu %}
      {% set hasSub = menuItem.sub is defined and menuItem.sub is not empty %}
      {% set isActive = menuKey == entityName or (hasSub and attribute(menuItem.sub, entityName) is defined) %}
      <li class="menu-items">
        <a class="menu-links {% if isActive %}active{% endif %} {% if isActive and hasSub %}expand{% endif %}"
          href="{% if menuItem.route %}{{ path(menuItem.route, {entityName: menuKey}) }}{% else %}#{% endif %}">
          <i class="material-icons">{{ menuItem.icon }}</i>
          {{ menuItem.title }}
          {% if hasSub %}
          <i class="expand-more material-icons">expand_more</i>
          {% endif %}
        </a>
        {% if hasSub %}
        <ul class="sub-menu {% if attribute(menuItem.sub, entityName) is defined %}show{% else %}hide{% endif %}">
          {% for subKey, subItem in menuItem.sub %}
          <li class="sub-menu-items">
            <a class="sub-menu-links {% if subKey == entityName %}active{% endif %}" href="{{ path(subItem.route, {entityName: subKey}) }}">{{ subItem.title }}</a>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>

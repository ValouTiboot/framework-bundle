{# Admin form theme: Bootstrap 5 horizontal layout (label left, field right), plus the translated fields (one input per language). #}
{% use "bootstrap_5_horizontal_layout.html.twig" %}

{%- block form_label_class -%}col-sm-3 col-lg-2{%- endblock form_label_class -%}
{%- block form_group_class -%}col-sm-9 col-lg-10 dgtx-form-group{%- endblock form_group_class -%}

{%- block form_widget_compound -%}
  {%- if form is rootform -%}
    {{ form_errors(form) }}
  {%- endif -%}
  {{- block('form_rows') -}}
  {{- form_rest(form) -}}
{%- endblock form_widget_compound -%}

{# a "translate" field: a collection keyed by language id, one row per language, the language code after the field #}
{%- block collection_widget -%}
  <div class="dgtx-translate" {{ block('widget_container_attributes') }}>
    {%- for child in form -%}
      <div class="dgtx-translate-entry">
        <div class="dgtx-translate-field">
          {{- form_widget(child) -}}
          {{- form_errors(child) -}}
        </div>
        <span class="dgtx-translate-lang" title="{{ dgtx_language_name(child.vars.name) }}">{{ dgtx_language_iso(child.vars.name)|upper }}</span>
      </div>
    {%- endfor -%}
  </div>
{%- endblock collection_widget -%}

{# an "embed" field (EmbedFieldType): one row per entry with a drag handle and a remove button, the add button clones the prototype (admin.js) #}
{%- block dgtx_embed_entry -%}
  <li class="dgtx-embed-entry">
    <span class="dgtx-embed-handle material-icons" aria-hidden="true">drag_indicator</span>
    <div class="dgtx-embed-fields">
      {%- for field in entry -%}
        {{- form_widget(field) -}}
        {{- form_errors(field) -}}
      {%- endfor -%}
    </div>
    <button type="button" class="btn btn-light dgtx-embed-remove" data-embed-remove title="{{ 'form.default.removeItem'|trans({}, 'Admin.Form.Default') }}">
      <i class="material-icons" aria-hidden="true">delete</i>
    </button>
  </li>
{%- endblock dgtx_embed_entry -%}

{%- block dgtx_embed_widget -%}
  {%- set prototype_markup = '' -%}
  {%- if prototype is defined -%}
    {%- set entry = prototype -%}
    {%- set prototype_markup = block('dgtx_embed_entry') -%}
  {%- endif -%}
  <div class="dgtx-embed" data-embed data-embed-prefix="{{ full_name }}" data-prototype="{{ prototype_markup|e('html_attr') }}" {{ block('widget_container_attributes') }}>
    <ol class="dgtx-embed-list" data-embed-list>
      {%- for entry in form -%}
        {{- block('dgtx_embed_entry') -}}
      {%- endfor -%}
    </ol>
    <button type="button" class="btn btn-light btn-sm dgtx-embed-add" data-embed-add>
      <i class="material-icons" aria-hidden="true">add</i> {{ 'form.default.addItem'|trans({}, 'Admin.Form.Default') }}
    </button>
  </div>
{%- endblock dgtx_embed_widget -%}

{# permission matrix of a role (PermissionsType): entities in rows, permissions in columns #}
{%- block dgtx_permissions_widget -%}
  {%- set columns = ['view', 'read', 'create', 'edit', 'delete', 'all'] -%}
  <div class="table-responsive">
    <table class="table dgtx-permissions" {{ block('widget_container_attributes') }}>
      <thead>
        <tr>
          <th scope="col">{{ 'label.role.entity'|trans({}, 'Admin.Fields.Label') }}</th>
          {%- for column in columns -%}
            <th scope="col" class="text-center">
              <label class="dgtx-permissions-col" title="{{ 'label.role.toggleColumn'|trans({}, 'Admin.Fields.Label') }}">
                <input type="checkbox" class="form-check-input" data-permission-column="{{ column }}">
                <span>{{ ('label.role.permission.' ~ column)|trans({}, 'Admin.Fields.Label') }}</span>
              </label>
            </th>
          {%- endfor -%}
        </tr>
      </thead>
      <tbody>
        {%- for row in form -%}
          <tr class="dgtx-permissions-row{% if row.vars.name == '_all' %} dgtx-permissions-wildcard{% endif %}{% if row.children.all.vars.checked %} is-all{% endif %}">
            <th scope="row">
              {%- if row.vars.translation_domain is same as(false) -%}
                {{ row.vars.label }}
              {%- else -%}
                {{ row.vars.label|trans({}, row.vars.translation_domain) }}
              {%- endif -%}
            </th>
            {%- for column in columns -%}
              {%- set box = row.children[column] -%}
              <td class="text-center">
                <input type="checkbox" class="form-check-input" id="{{ box.vars.id }}" name="{{ box.vars.full_name }}" value="{{ box.vars.value }}" data-permission="{{ column }}" {% if box.vars.checked %}checked{% endif %} aria-label="{{ ('label.role.permission.' ~ column)|trans({}, 'Admin.Fields.Label') }}">
              </td>
            {%- endfor -%}
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
{%- endblock dgtx_permissions_widget -%}

{%- block submit_widget -%}
  {%- set attr = attr|merge({class: (attr.class|default('btn-primary') ~ ' btn')|trim}) -%}
  {{- parent() -}}
{%- endblock submit_widget -%}

{%- block button_widget -%}
  {%- set attr = attr|merge({class: (attr.class|default('btn-light') ~ ' btn')|trim}) -%}
  {{- parent() -}}
{%- endblock button_widget -%}

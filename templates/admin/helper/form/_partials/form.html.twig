{% extends '@DigitixFramework/admin/helper/form/create.html.twig' %}
{% form_theme form '@DigitixFramework/admin/_partials/form_theme.html.twig' %}

{% block form %}
  {{ form_start(form) }}
    {{ form_errors(form) }}

    {% for key, field in fields %}
      {% if key not in ['saveAndStay', 'save'] and form.children[key] is defined %}
        {{ form_row(form.children[key]) }}

        {% if key in uploadfields and upload_values[key]|default(null) %}
          <div class="mb-3">
            <img class="dgtx-upload-preview" src="{{ asset('uploads/' ~ entityName ~ '/' ~ key ~ '/' ~ upload_values[key]) }}" alt="">
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}

    {% block form_footer %}
    <div class="dgtx-form-footer">
      {% if hasReturnLink %}
        <a class="btn btn-light dgtx-form-back" href="{{ path('dgtx_admin_entity_read', {entityName: entityName}) }}">
          {{ 'form.default.back'|trans({}, 'Admin.Form.Default') }}
        </a>
      {% endif %}
      {% if form.children.saveAndStay is defined %}
        {{ form_widget(form.children.saveAndStay, {attr: {class: 'btn-light'}}) }}
      {% endif %}
      {% if form.children.save is defined %}
        {{ form_widget(form.children.save, {attr: {class: 'btn-primary'}}) }}
      {% endif %}
    </div>
    {% endblock %}
  {{ form_end(form) }}
{% endblock %}

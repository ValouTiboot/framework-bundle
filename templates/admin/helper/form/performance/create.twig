{% extends '@DigitixFramework/admin/helper/form/_partials/form.html.twig' %}

{% block form %}
  {{ form_start(form) }}
  {{ form_row(form.cache) }}
  {{ form_row(form.compile) }}
  {{ form_row(form.compileCss) }}
  {{ form_row(form.compileJs) }}
  {{ form_row(form.debug) }}
  <div class="mb-3 row">
    <label class="col-sm-2 text-end col-form-label"></label>
    <div class="col-sm-9">
      <a href="{{ path(app.request.get('_route'), {entityName: entityName}) }}?cacheClear" class="btn btn-info">{{ 'form.default.delCache'|trans({}, 'Admin.Form.Default') }}</a>
    </div>
  </div>

  <div class="form-buttons d-flex align-items-center justify-content-end mt-5">

    {% if hasReturnLink %}
      <div class="mr-auto">
        <a class="btn btn-light" href="{{ path('dgtx_admin_entity_read', {entityName: entityName}) }}">
          {{ 'form.default.back'|trans({}, 'Admin.Form.Default') }}
        </a>
      </div>
    {% endif %}

    {% for key, field in fields %}
      {% if key in ['saveAndStay'] %}
        {{ form_widget(attribute(form.children, key)) }}
      {% endif %}
    {% endfor %}

    {{ form_widget(attribute(form.children, 'save')) }}

  </div>
{% endblock %}

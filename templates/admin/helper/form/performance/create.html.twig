{% extends '@DigitixFramework/admin/helper/form/_partials/form.html.twig' %}

{% block form %}
  {{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.cache) }}
    {{ form_row(form.compile) }}
    {{ form_row(form.compileCss) }}
    {{ form_row(form.compileJs) }}
    {{ form_row(form.debug) }}

    <div class="dgtx-form-footer">
      {{ form_widget(form.children.save, {attr: {class: 'btn-primary'}}) }}
    </div>
  {{ form_end(form) }}

  <form method="post" action="{{ path('dgtx_admin_entity_create', {entityName: entityName}) }}" class="mt-4">
    <input type="hidden" name="cacheClear" value="1">
    <input type="hidden" name="_token" value="{{ csrf_token('dgtx_cache_clear') }}">
    <button type="submit" class="btn btn-light">
      <i class="material-icons">cached</i>
      {{ 'form.default.delCache'|trans({}, 'Admin.Form.Default') }}
    </button>
  </form>
{% endblock %}

{% extends '@DigitixFramework/admin/layout.html.twig' %}

{% block page_subtitle %}
  {% if hasReturnLink %}
    <div class="dgtx-page-subtitle">
      {{ (app.request.attributes.get('entityId') ? 'form.default.edit' : 'form.default.new')|trans({}, 'Admin.Form.Default') }}
    </div>
  {% endif %}
{% endblock %}

{% block page_actions %}
  {% if hasReturnLink %}
    <a href="{{ path('dgtx_admin_entity_read', {entityName: entityName}) }}" class="btn btn-light">
      <i class="material-icons">arrow_back</i>
      {{ 'form.default.back'|trans({}, 'Admin.Form.Default') }}
    </a>
  {% endif %}
{% endblock %}

{% block content %}
  <div class="dgtx-form">
    {% block form %}{% endblock %}
  </div>
{% endblock %}

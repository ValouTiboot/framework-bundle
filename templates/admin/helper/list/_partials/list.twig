{# The filters form is rendered empty outside the table: its inputs live in the
   table header and reference it through the HTML "form" attribute, so that the
   per-row delete forms are never nested inside it (nested forms are invalid). #}
{% set filters_form_id = 'dgtx-filters-' ~ entityName %}
{{ form_start(filters_form, {attr: {id: filters_form_id}}) }}{{ form_end(filters_form, {render_rest: false}) }}

<div class="table-responsive">
	<table class="table table-hover {% if sortable %}sortable{% endif %}" {% if sortable %}data-sortable-action="{{ url('dgtx_admin_entity_ajax_sortable', {entityName: entityName}) }}"{% endif %}>
		<thead>
			{% block list_label %}
			<tr>
				{% if sortable %}
				<th scope="col" width="2%"></th>
				{% endif %}
				{% for field in list_fields %}
				<th scope="col" width="{% if field.property == 'id' %}4%{% elseif field.property == 'dateAdd' %}10%{% elseif field.type == 'sortable' %}2%{% elseif field.property == 'active' %}4%{% else %}auto{% endif %}">
					<div class="head d-flex align-items-center">
						<span>{{ field.label|trans({}, 'Admin.Fields.Label') }}</span>
						{% if field.sortable %}
							<div class="sorter ms-1 d-flex">
								<a href="{{ sorter.generateLink(field.name, 'asc') }}" class="{% if sorter.orderBy == field.name and sorter.orderWay == 'asc' %}active{% endif %}">
									<i class="material-icons">expand_less</i>
								</a>
								<a href="{{ sorter.generateLink(field.name, 'desc') }}" class="{% if sorter.orderBy == field.name and sorter.orderWay == 'desc' %}active{% endif %}">
									<i class="material-icons">expand_more</i>
								</a>
							</div>
						{% endif %}
					</div>
				</th>
				{% endfor %}

				<th scope="col" class="text-end" width="8%">{{ 'list.default.actions'|trans({}, 'Admin.List.Default') }}</th>
			</tr>
			{% endblock %}
			{% block filters %}
				{% form_theme filters_form '@DigitixFramework/admin/_partials/form_theme.twig' %}
				{% if filters_form.children|length %}
				<tr>
					{% if sortable %}
					<th></th>
					{% endif %}
					{% for field in list_fields %}
						{% if attribute(filters_form.children, field.property) is defined %}
							<th>
								{{ form_widget(attribute(filters_form.children, field.property), {attr: {form: filters_form_id}}) }}
							</th>
						{% else %}
							<th></th>
						{% endif %}
					{% endfor %}
					<th class="text-end">
						<button type="submit" form="{{ filters_form_id }}" class="btn btn-outline-primary">{{ 'list.default.filter'|trans({}, 'Admin.List.Default') }}</button>
					</th>
				</tr>
				{% endif %}
			{% endblock %}
		</thead>
		<tbody>
		{% for entity in entities %}
			<tr {% if sortable %}id="{{ entityName ~ '_' ~ entity.id }}"{% endif %}>
				{% if sortable %}
				<td class="sortable-cell"><i class="material-icons sortable-item">drag_indicator</i></td>
				{% endif %}

				{% for field in list_fields %}
					{% set item = attribute(entity, field.property) %}

					{% if field.type == 'iterable' and item is iterable %}
						<td>{{ item|join(', ') }}</td>
					{% elseif field.type == 'entity' %}
						<td>
							{% if item is not null %}
								{% if field.column is not null %}
									{{ attribute(item, field.column) }}
								{% else %}
									{{ item.name }}
								{% endif %}
							{% else %}
								--
							{% endif %}
						</td>
					{% elseif field.type == 'datetime' %}
						<td>{{ item ? item|date('d/m/Y H:i:s') : '--' }}</td>
					{% elseif field.type == 'bool' %}
						<td class="text-center">
							<i class="material-icons {% if item %}t-success{% else %}t-danger{% endif %}">{% if item %}check{% else %}close{% endif %}</i>
						</td>
					{% elseif field.type == 'choice' %}
						<td>{{ ('label.' ~ entityName ~ '.' ~ item)|trans({}, 'Admin.Fields.Label') }}</td>
					{% elseif field.type == 'sortable' %}
						<td class="text-center">{{ item }}</td>
					{% else %}
						<td>{{ item }}</td>
					{% endif %}
				{% endfor %}

				<td class="text-end">
					{% for action in actions %}
						{% if action == 'delete' %}
							<form method="post" action="{{ path('dgtx_admin_entity_delete', {entityName: entityName, entityId: entity.id}) }}" class="d-inline item-delete-form" onsubmit="return confirm('{{ 'list.default.confirm_delete'|trans({}, 'Admin.List.Default')|e('js') }}');">
								<input type="hidden" name="_token" value="{{ csrf_token('dgtx_delete_' ~ entity.id) }}" />
								<button type="submit" class="item-delete btn btn-link p-0 align-baseline" title="{{ 'list.default.delete'|trans({}, 'Admin.List.Default') }}">
									<i class="material-icons">delete</i>
								</button>
							</form>
						{% else %}
							<a class="item-{{ action }}" href="{{ path('dgtx_admin_entity_' ~ action, {entityName: entityName, entityId: entity.id}) }}">
								{% if action == 'view' or action == 'view_entity' %}
									<i class="material-icons">visibility</i>
								{% else %}
									<i class="material-icons">{{ action }}</i>
								{% endif %}
							</a>
						{% endif %}
					{% endfor %}
				</td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
</div>

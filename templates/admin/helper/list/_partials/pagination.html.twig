{% block pagination %}
{% if pagination is defined and pagination is not null and pagination.totalPages > 1 %}
  <nav class="d-flex justify-content-end mt-2" aria-label="Pagination">
    <ul class="pagination pagination-sm">
      <li class="page-item {% if not pagination.hasPreviousPage %}disabled{% endif %}">
        <a class="page-link page-link-i" href="{{ pagination.getPageLink(pagination.firstPage) }}" aria-label="First">
          <i class="material-icons">first_page</i>
        </a>
      </li>
      <li class="page-item {% if not pagination.hasPreviousPage %}disabled{% endif %}">
        <a class="page-link page-link-i" href="{{ pagination.getPageLink(pagination.previousPage) }}" aria-label="Previous">
          <i class="material-icons">navigate_before</i>
        </a>
      </li>

      {% set current = pagination.currentPage %}
      {% set ellipsisBefore = false %}
      {% set ellipsisAfter = false %}

      {% for p in 1..pagination.totalPages %}
        {% if p < current - 2 %}
          {% if not ellipsisBefore %}
            <li class="page-item disabled"><a class="page-link" href="#">&hellip;</a></li>
            {% set ellipsisBefore = true %}
          {% endif %}
        {% elseif p > current + 2 %}
          {% if not ellipsisAfter %}
            <li class="page-item disabled"><a class="page-link" href="#">&hellip;</a></li>
            {% set ellipsisAfter = true %}
          {% endif %}
        {% else %}
          <li class="page-item {% if p == current %}active{% endif %}" {% if p == current %}aria-current="page"{% endif %}>
            <a href="{{ pagination.getPageLink(p) }}" class="page-link">{{ p }}</a>
          </li>
        {% endif %}
      {% endfor %}

      <li class="page-item {% if not pagination.hasNextPage %}disabled{% endif %}">
        <a class="page-link page-link-i" href="{{ pagination.getPageLink(pagination.nextPage) }}" aria-label="Next">
          <i class="material-icons">navigate_next</i>
        </a>
      </li>
      <li class="page-item {% if not pagination.hasNextPage %}disabled{% endif %}">
        <a class="page-link page-link-i" href="{{ pagination.getPageLink(pagination.lastPage) }}" aria-label="Last">
          <i class="material-icons">last_page</i>
        </a>
      </li>
    </ul>
  </nav>
{% endif %}
{% endblock %}

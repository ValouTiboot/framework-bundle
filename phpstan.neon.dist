parameters:
    level: 6
    tmpDir: var/phpstan
    paths:
        - src
        - tests
    excludePaths:
        - tests/App/var (?)
    treatPhpDocTypesAsCertain: false
    # Translatable entities expose translated fields through __get/__set/__call
    universalObjectCratesClasses:
        - Digitix\FrameworkBundle\Entity\Translatable\Translatable
    doctrine:
        # NOT NULL columns are typed "?string = null" until the row is persisted (Symfony maker style)
        allowNullablePropertyForRequiredField: true
    ignoreErrors:
        # RuntimeTranslator extends the framework translator (marked @final, not final) to load
        # the catalogue files generated from the database; covered by TranslationWorkflowTest.
        -
            message: '#extends @final class Symfony\\Bundle\\FrameworkBundle\\Translation\\Translator#'
            path: src/Translation/RuntimeTranslator.php

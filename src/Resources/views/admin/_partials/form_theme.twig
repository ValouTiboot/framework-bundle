{% use "bootstrap_4_horizontal_layout.html.twig" %}

{% block form_label_class -%}
col-sm-2 text-right
{%- endblock form_label_class %}

{% block form_group_class -%}
col-sm-9
{%- endblock form_group_class %}

{% block form_group_submit_class -%}
col text-right
{%- endblock form_group_submit_class %}


{%- block form_widget_compound -%}
    {#<div {{ block('widget_container_attributes') }}>#}
        {%- if form is rootform -%}
            {{ form_errors(form) }}
        {%- endif -%}
        {{- block('form_rows') -}}
        {{- form_rest(form) -}}
    {#</div>#}
{%- endblock form_widget_compound -%}

{% block fieldset_form_row -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~"_help"}} -%}
    {%- endif -%}
    <div{% with {attr: row_attr|merge({class: (row_attr.class|default('') ~ ' form-group row')|trim})} %}{{ block('attributes') }}{% endwith %}>
        
        {{- form_label(form) -}}
        <div class="{{ block('form_group_class') }}">
            {{- form_widget(form, widget_attr) -}}
            {{- form_help(form) -}}
        </div>
        
{##}</div>
{%- endblock fieldset_form_row %}

{% block form_row -%}
    {%- if expanded is defined and expanded -%}
        {{ block('fieldset_form_row') }}
    {%- else -%}
	    {%- set widget_attr = {} -%}
	    {%- if help is not empty -%}
	        {%- set widget_attr = {attr: {'aria-describedby': id ~"_help"}} -%}
	    {%- endif -%}
	    {%- if compound is defined and compound -%}
	    	{{- form_widget(form, widget_attr) -}}
    	{%- else -%}
	        <div{% with {attr: row_attr|merge({class: (row_attr.class|default('') ~ ' form-group row' ~ ((not compound or force_error|default(false)) and not valid ? ' is-invalid'))|trim})} %}{{ block('attributes') }}{% endwith %}>
	            {{- form_label(form) -}}
	            <div class="{{ block('form_group_class') }}">
	                {{- form_widget(form, widget_attr) -}}
	                {{- form_help(form) -}}
	            </div>
	    	</div>
    	{%- endif -%}
    {%- endif -%}
{%- endblock form_row %}

{% block submit_row -%}
    <div{% with {attr: row_attr|merge({class: (row_attr.class|default('') ~ ' submit form-group row')|trim})} %}{{ block('attributes') }}{% endwith %}>{#--#}
        {#-<div class="{{ block('form_label_class') }}"></div>-#}
        <div class="{{ block('form_group_submit_class') }}">
            {{- form_widget(form) -}}
        </div>{#--#}
    </div>
{%- endblock submit_row %}

{% block date_widget -%}
    {%- if widget != 'single_text' and not valid -%}
        {% set attr = attr|merge({class: (attr.class|default('') ~ ' form-control is-invalid')|trim}) -%}
        {% set valid = true %}
        {{- parent() -}}
    {%- else -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-inline date-select')|trim}) -%}
        {%- if datetime is not defined or not datetime -%}
            <div class="form-group row">
                {{- form_label(form) -}}
                <div class="{{ block('form_group_class') }}">
                    <div {{ block('widget_container_attributes') -}}>
        {%- endif %}
            {{- date_pattern|replace({
                '{{ year }}': form_widget(form.year),
                '{{ month }}': form_widget(form.month),
                '{{ day }}': form_widget(form.day),
            })|raw -}}
        {%- if datetime is not defined or not datetime -%}
                    </div>
                </div>
            </div>
        {%- endif -%}
    {%- endif -%}
{%- endblock date_widget %}


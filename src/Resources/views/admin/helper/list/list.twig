{% extends '@DigitixFramework/admin/layout.html.twig' %}

{% block content_header %}
	<div class="content-header bg-white">
		<div class="d-flex align-items-center justify-content-between">
			<div class="content-header-title">{{ controllerName }}</div>
			<div class="content-header-btn">
				{% if header_link is defined and header_link|length %}
					{% for h_link in header_link %}
					<a href="{{ path('dgtx_admin_entity_read', {entityName: h_link.entity}) }}" class="btn btn-outline-primary me-1">
						<i class="material-icons">control_point</i>
						{{ h_link.name|trans({}, 'Admin.Fields.Label') }}
					</a>
				</a>
					{% endfor %}
				{% endif %}
				<a href="{{ path('dgtx_admin_entity_create', {entityName: entityName}) }}" class="btn btn-primary">
					<i class="material-icons md-light">control_point</i>
					{{ 'list.default.add'|trans({}, 'Admin.List.Default') }}
				</a>
			</div>
		</div>
	</div>
{% endblock %}

{% block toolbar%}
	{% if toolbar|length %}
	<div class="bg-white toolbar d-flex align-items-center justify-content-between px-3">
		<div class="item-count text-muted">
			{{ 'list.default.total'|trans({}, 'Admin.List.Default') }} <small>({{ total_items }})</small>
		</div>
		<div class="d-flex align-items-center justify-content-end">
		{% for btn in toolbar %}
			<a href="{{ path('dgtx_admin_entity_create', {entityName: entityName}) }}" alt="{{ btn }}" title="{{ btn }}" class="toolbar-btn
				{% if btn == 'backup' %}
					t-success
				{% else %}
					t-primary
				{% endif %}">
				<i class="material-icons">{{ btn }}</i>
			</a>
		{% endfor %}
		</div>
	</div>
	{% endif %}
{% endblock %}

{% block content%}

	{% block list %}
		{% include '@DigitixFramework/admin/helper/list/_partials/list.twig' %}
	{% endblock %}

	{% block pagination %}
		{% include '@DigitixFramework/admin/helper/list/_partials/pagination.twig' %}
	{% endblock %}

{% endblock %}
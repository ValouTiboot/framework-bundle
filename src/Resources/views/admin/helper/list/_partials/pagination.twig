{% block pagination%}
	<nav class="d-flex justify-content-end margin-t-10" aria-label="...">
		<ul class="pagination pagination-sm">
		    <li class="page-item">
		      	<a class="page-link page-link-i" href="{{ pagination.getPageLink(pagination.firstPage) }}" aria-label="First">
			        <i class="material-icons">first_page</i>
			    </a>
		    </li>
		    <li class="page-item {% if not pagination.PrevPage %}disabled{% endif %}">
		      	<a class="page-link page-link-i" href="{{ pagination.getPageLink(pagination.getPreviousPage) }}" aria-label="Previous">
			        <i class="material-icons">navigate_before</i>
			    </a>
		    </li>

			{% set counter = 1 %}
		    {% set condprev = true %}
		    {% set condnext = true %}
		    {% set current = pagination.currentPage %}

		    {% for k,p in 1..pagination.totalPages %}
		    	{% if  condprev and p < current-2 %}
		    		<li class="page-item disabled">
		    			<a class="page-link" href="#">&hellip;</a>
		    		</li>

				    {% set condprev = false %}
				    {% set counter = current-2 %}

		    	{% elseif condnext and p > current+2 %}
		    		<li class="page-item disabled">
		    			<a class="page-link" href="#">&hellip;</a>
		    		</li>
				    
				    {% set condnext = false %}
		    	
		    	{% elseif counter <= p and condnext %}
				    
				    <li class="page-item {% if p == current %}active{% endif %}">
				      	<a href="{{ pagination.getPageLink(p) }}" class="page-link">
				        	{{ p }}
				        	<span class="sr-only">(current)</span>
				      	</a>
				    </li>
				    
		    	{% endif %}

		    {% endfor %}
		    
		    <li class="page-item {% if not pagination.NPage %}disabled{% endif %}">
		      	<a class="page-link page-link-i" href="{{ pagination.getPageLink(pagination.getNextPage) }}" aria-label="Next">
		      		<i class="material-icons">navigate_next</i>
			    </a>
		    </li>
		    <li class="page-item">
		      	<a class="page-link page-link-i" href="{{ pagination.getPageLink(pagination.lastPage) }}" aria-label="Last">
		      		<i class="material-icons">last_page</i>
			    </a>
		    </li>
		</ul>
	</nav>

{% endblock %}
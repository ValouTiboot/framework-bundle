{{ form_start(filters_form) }}
<div class="table-responsive">
	<table class="table table-hover {% if sortable %}sortable{% endif %}" {% if sortable %}data-sortable-action="{{ url('dgtx_admin_entity_ajax_sortable', {entityName: entity_name}) }}"{% endif %}>
		<thead>
			{% block list_label %}
			<tr>
				{% if sortable %}
				<th scope="col" width="2%"></th>
				{% endif %}
				{% for field in list_fields %}
				<th scope="col" width="{% if field.name == 'id' %}4%{% elseif field.name == 'dateAdd' %}10%{% elseif field.type == 'sortable' %}2%{% elseif field.name == 'active' %}4%{% else %}auto{% endif %}">
					<div class="head d-flex align-items-center">
						<span>{{ field.label|trans({}, 'Admin.Fields.Label') }}</span>
						{% if field.sort is defined %}
							<div class="sorter ms-1 d-flex">
								<a href="{{ sorter.generateLink(field.name, 'asc') }}" class="{% if sorter.orderBy == field.name and sorter.orderWay == 'asc' %}active{% endif %}">
									<i class="material-icons">expand_less</i>
								</a>
								<a href="{{ sorter.generateLink(field.name, 'desc') }}" class="{% if sorter.orderBy == field.name and sorter.orderWay == 'desc' %}active{% endif %}">
									<i class="material-icons">expand_more</i>
								</a>
							</div>
						{% endif %}
					</div>
				</th>
				{% endfor %}

				<th scope="col" class="text-end" width="8%">{{ 'list.default.actions'|trans({}, 'Admin.List.Default') }}</th>
			</tr>
			{% endblock %}
			{% block filters %}
				{% form_theme filters_form '@DigitixFramework/admin/_partials/form_theme.twig' %}
				{% if filters_form is defined and filters_form.children|length %}
				<tr>
					{% if sortable %}
					<th></th>
					{% endif %}
					{% for field in list_fields %}
						{% if attribute(filters_form.children, field.name) is defined %}
							<th>
								{{ form_widget(attribute(filters_form.children, field.name)) }}
							</th>
						{% else %}
							<th></th>
						{% endif %}
					{% endfor %}
					<th class="text-end">
						<button type="submit" class="btn btn-outline-primary">{{ 'list.default.filter'|trans({}, 'Admin.List.Default') }}</button>
					</th>
				</tr>
				{% endif %}
			{% endblock %}
		</thead>
		<tbody>
		{% for entity in entities %}
			<tr {% if sortable %}id="{{ entity_name ~ '_' ~ entity.id }}"{% endif %}>
				{% if sortable %}
				<td class="sortable-cell"><i class="material-icons sortable-item">drag_indicator</i></td>
				{% endif %}

				{% for field in list_fields %}
					{% set item = attribute(entity, field.name) %}

					{% if field.type ==  'iterable' and item is iterable %}
						<td>{{ item|join(', ') }}</td>
					{% elseif field.type == 'entity' %}
						<td>
							{% if item.id is defined %}
								{% if field.column is defined %}
									{{ attribute(item, field.column) }}
								{% else %}
									{{ item.name }}
								{% endif %}
							{% else %}
								--
							{% endif %}
						</td>
					{% elseif field.type == 'datetime' %}
						<td>{{ item|date('d/m/Y H:i:s') }}</td>
					{% elseif field.type == 'bool' %}
						<td class="text-center">
							<i class="material-icons {% if item %}t-success{% else %}t-danger{% endif %}">{% if item %}check{% else %}close{% endif %}</i>
						</td>
					{% elseif field.type == 'choice' %}
						{% set choice = 'label.' ~ entity_name ~ '.' ~ item %}
						<td>{{ choice|trans({}, 'Admin.Fields.Label') }}</td>
					{% elseif field.type == 'sortable' %}
						<td class="text-center">{{ item }}</td>
					{% else %}
						<td>{{ item }}</td>
					{% endif %}

				{% endfor %}
				<td class="text-end">
					{% for action in actions %}
					<a class="item-{{ action }}" href="{{ path('dgtx_admin_entity_'~action, {entityName: entity_name, entityId: entity.id}) }}">
						<i class="material-icons">{{ action }}</i>
					</a>
					{% endfor %}
				</td>
			</tr>

		{% endfor %}
		</tbody>
	</table>
</div>
{{ form_end(filters_form) }}

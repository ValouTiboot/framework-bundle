{% extends '@DigitixFramework/admin/helper/form/create.twig' %}
{% form_theme form '@DigitixFramework/admin/_partials/form_theme.twig' %}

{% block form %}
  {{ form_start(form) }}
    <div class="form-errors">
      {{ form_errors(form) }}
    </div>

    {% for key, field in fields %}
      {% if key not in ['saveAndStay', 'save'] and form.children[key] is defined %}

        {{ form_row(form.children[key]) }}

        {% if key in uploadfields and upload_values[key]|default(null) %}
          <div class="form-group row">
            <label class="col-sm-2"></label>
            <div class="col-sm-9">
              <img src="{{ asset('uploads/' ~ entityName ~ '/' ~ key ~ '/' ~ upload_values[key]) }}" width="200" alt="" />
            </div>
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}

    <div class="form-buttons d-flex align-items-center justify-content-end mt-5">

      {% if hasReturnLink %}
        <div class="me-3">
          <a class="btn btn-light" href="{{ path('dgtx_admin_entity_read', {entityName: entityName}) }}">
            {{ 'form.default.back'|trans({}, 'Admin.Form.Default') }}
          </a>
        </div>
      {% endif %}

      {% if form.children.saveAndStay is defined %}
        {{ form_widget(form.children.saveAndStay) }}
      {% endif %}

      {% if form.children.save is defined %}
        {{ form_widget(form.children.save) }}
      {% endif %}

    </div>

  {{ form_end(form) }}
{% endblock %}

{% extends '@DigitixFramework/admin/helper/form/create.twig' %}
{% form_theme form '@DigitixFramework/admin/_partials/form_theme.twig' %}

{% block form %}
  {{ form_start(form) }}
    <div class="form-errors">
      {{ form_errors(form) }}
    </div>

    {% for key, field in fields %}
      {% if key not in ['saveAndStay'] %}

        {{ form_row(attribute(form.children, key)) }}

        {% if key in uploadfields %}
          {% set row = attribute(form.children, key) %}

          {% if row.vars.data is defined and row.vars.data is not empty %}
          <div class="form-group row">
            <label class="col-sm-2"></label>
            <div class="col-sm-9">
              <img src="{{ asset('uploads/' ~ entityName ~ '/' ~ key ~ '/' ~ row.vars.data) }}" width="200" />
            </div>
          </div>
          {% endif %}

        {% endif %}
      {% endif %}
    {% endfor %}

    <div class="form-buttons d-flex align-items-center justify-content-end mt-5">

      {% if hasReturnLink %}
        <div class="me-3">
          <a class="btn btn-light" href="{{ path('dgtx_admin_entity_read', {entityName: entityName}) }}">
            {{ 'form.default.back'|trans({}, 'Admin.Form.Default') }}
          </a>
        </div>
      {% endif %}

      {% for key, field in fields %}
        {% if key in ['saveAndStay'] %}
          {{ form_widget(attribute(form.children, key)) }}
        {% endif %}
      {% endfor %}

      {{ form_widget(attribute(form.children, 'save')) }}

    </div>

  {{ form_end(form) }}
{% endblock %}

{% extends '@DigitixFramework/admin/layout.html.twig' %}
{% form_theme form '@DigitixFramework/admin/_partials/form_theme.twig' %}

{% block content_header %}
<div class="content-header bg-white padding-30 margin-b-20">
	<div class="d-flex align-items-center justify-content-between">
		<div class="content-header-title">{{ controller_name }}</div>
	</div>
</div>
{% endblock %}

{% block toolbar%}
	<div class="bg-white toolbar">
		<div class="d-flex align-items-center justify-content-between">
			{% if has_return_link %}
			<a href="{{ path('dgtx_admin_entity_read', {entityName: entity_name}) }}" class="toolbar-btn alt-bg-primary">
				<i class="material-icons md-light">arrow_back</i>
			</a>
			{% endif %}
			{% if toolbar is defined and toolbar|length %}
				<span>
					{% for btn in toolbar %}
					<a href="{{ path('dgtx_admin_entity_create', {entityName: entity_name}) }}" class="toolbar-btn
						{% if btn == 'add' %}
							alt-bg-primary
						{% elseif btn == 'backup' %}
							alt-bg-success
						{% endif %}">
						<i class="material-icons md-light">{{ btn }}</i>
					</a>
					{% endfor %}
				</span>
			{% endif %}
		</div>
	</div>
{% endblock %}

{% block content%}
	<div class="dgtx-form">
		{{ form(form) }}
		{% if has_return_link %}
			<div class="form-return-link">
				<a class="btn btn-info" href="{{ path('dgtx_admin_entity_read', {entityName: entity_name}) }}">{{ 'form.default.back'|trans({}, 'Admin.Form.Default') }}</a>
			</div>
		{% endif %}
	</div>
{% endblock %}

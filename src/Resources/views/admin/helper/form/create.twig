{% extends '@DigitixFramework/admin/layout.html.twig' %}
{% form_theme form '@DigitixFramework/admin/_partials/form_theme.twig' %}

{% block content_header %}
<div class="content-header bg-white">
	<div class="d-flex align-items-center justify-content-between">
		<div class="content-header-title">{{ controller_name }}</div>
	</div>
</div>
{% endblock %}

{% block toolbar%}
	<div class="bg-white toolbar">
		<div class="d-flex align-items-center justify-content-between">
			{% if has_return_link %}
			<a href="{{ path('dgtx_admin_entity_read', {entityName: entity_name}) }}" class="toolbar-btn alt-bg-primary">
				<i class="material-icons md-light">arrow_back</i>
			</a>
			{% endif %}
			{% if toolbar is defined and toolbar|length %}
				<span>
					{% for btn in toolbar %}
					<a href="{{ path('dgtx_admin_entity_create', {entityName: entity_name}) }}" class="toolbar-btn
						{% if btn == 'add' %}
							alt-bg-primary
						{% elseif btn == 'backup' %}
							alt-bg-success
						{% endif %}">
						<i class="material-icons md-light">{{ btn }}</i>
					</a>
					{% endfor %}
				</span>
			{% endif %}
		</div>
	</div>
{% endblock %}

{% block content%}
	<div class="dgtx-form">
		{{ form_start(form) }}
			<div class="form-errors">
				{{ form_errors(form) }}
			</div>

			{% for key, field in fields %}
				{% if key not in ['saveAndStay'] %}

					{{ form_row(attribute(form.children, key)) }}

					{% if key in uploadfields %}
						{% set row = attribute(form.children, key) %}

						{% if row.vars.data is defined and row.vars.data is not empty %}
						<div class="form-group row">
							<label class="col-sm-2"></label>
							<div class="col-sm-9">
								<img src="{{ asset('uploads/' ~ entity_name ~ '/' ~ key ~ '/' ~ row.vars.data) }}" width="200" />
							</div>
						</div>
						{% endif %}

					{% endif %}
				{% endif %}
			{% endfor %}

			<div class="form-buttons d-flex align-items-center">

				{% if has_return_link %}
					<div class="mr-auto">
						<a class="btn btn-light" href="{{ path('dgtx_admin_entity_read', {entityName: entity_name}) }}">
							{{ 'form.default.back'|trans({}, 'Admin.Form.Default') }}
						</a>
					</div>
				{% endif %}

				{% for key, field in fields %}
					{% if key in ['saveAndStay'] %}
						{{ form_widget(attribute(form.children, key)) }}
					{% endif %}
				{% endfor %}

				{{ form_widget(attribute(form.children, 'save')) }}

			</div>


		{{ form_end(form) }}
		
	</div>
{% endblock %}

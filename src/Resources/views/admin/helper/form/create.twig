{% extends '@DigitixFramework/admin/layout.html.twig' %}

{% block content_header %}
<div class="content-header bg-white">
	<div class="d-flex align-items-center justify-content-between">
		<div class="content-header-title">{{ controllerName }}</div>
	</div>
</div>
{% endblock %}

{% block toolbar%}
	<div class="bg-white toolbar">
		<div class="d-flex align-items-center justify-content-between">
			{% if hasReturnLink %}
			<a href="{{ path('dgtx_admin_entity_read', {entityName: entityName}) }}" class="toolbar-btn alt-bg-primary">
				<i class="material-icons md-light">arrow_back</i>
			</a>
			{% endif %}
			{% if toolbar is defined and toolbar|length %}
				<span>
					{% for btn in toolbar %}
					<a href="{{ path('dgtx_admin_entity_create', {entityName: entityName}) }}" class="toolbar-btn
						{% if btn == 'add' %}
							alt-bg-primary
						{% elseif btn == 'backup' %}
							alt-bg-success
						{% endif %}">
						<i class="material-icons md-light">{{ btn }}</i>
					</a>
					{% endfor %}
				</span>
			{% endif %}
		</div>
	</div>
{% endblock %}

{% block content%}
	<div class="dgtx-form">
		{% block form %}{% endblock %}
	</div>
{% endblock %}

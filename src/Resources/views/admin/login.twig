{% extends '@DigitixFramework/admin/layout.html.twig' %}

{% block page_title %}Log in!{% endblock %}

{% block header %}{% endblock %}
{% block menu %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
<body id="login">
	{% block wrapper %}
	<div class="container-fluid w-100 h-100">
		<div class="row align-items-center justify-content-center mb-2">
			<div class="col-lg-1 col-md-2 col-8 text-center">
			  <img src="{{ asset('bundles/digitixframework/assets/images/phoenix.svg') }}" />
			</div>
		</div>
		<div class="row align-items-center justify-content-center">
			<div class="col-lg-3 col-md-6 col-12">
				<div id="login-form-container" class="row">
					<div class="col">
						<div class="row justify-content-center">
							<div class="col-10">
								<form method="post">
									<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />

									{% if error %}
										<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
									{% endif %}

									{% if app.user %}
										<div class="mb-3">
										    You are logged in as {{ app.user.username }}, <a href="{{ path('dgtx_admin_logout') }}">Logout</a>
										</div>
									{% endif %}
									<div class="form-group mb-2">
										<label class="control-label" for="loginEmail">Email</label>
										<input type="email" value="{{ last_username }}" name="email" id="loginEmail" class="form-control" required autofocus placeholder="test@domain.tld" />
									</div>
									<div class="form-group mb-2">
										<label for="loginPassword">Password</label>
										<input type="password" name="password" id="loginPassword" class="form-control" required placeholder="Password" />
									</div>

									<div class="form-group form-check mb-2">
									  <input type="checkbox" id="loginRememberMe" class="form-check-input" name="_remember_me">
									  <label class="form-check-label" for="loginRememberMe">Remember me</label>
									</div>

								  <button class="btn btn-primary w-100 justify-content-center" type="submit">Sign in</button>
								</form>
							</div>
						</div>
					</div>
				</div>

				<div id="version" class="row align-items-center justify-content-between mt-4">
					<div class="col-auto pl-0">
						<span>v2.0.0</span>
					</div>
					<div class="col-auto px-0">
						<span>&copy; Digitix {{'now'|date('Y')}} - All rights reserved</span>
					</div>
					<div class="col-auto pr-0">
						<a href="https://www.digitix.agency" class="site-link">
							<img src="{{ asset('bundles/digitixframework/assets/images/logo-full.png') }}" />
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
	{% endblock %}
</body>
{% endblock %}

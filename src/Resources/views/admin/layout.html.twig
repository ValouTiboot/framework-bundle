<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noodp, noimageindex, notranslate, nocache" />
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta name="generator" content="DgtxAdmin" />

    <link rel="shortcut icon" href="{{ asset('bundles/digitixframework/assets/images/favicon.ico') }}" type="image/x-icon" />

    <title>DgtxAdmin - {% block seo_title %}{% endblock %}</title>

    {% block head_stylesheets %}
	<link rel="stylesheet" href="{{ asset('bundles/digitixframework/css/theme.css') }}">
    {% endblock %}

    {% block configured_stylesheets %}
    	{#
        {% for css_asset in ea.assets.cssFiles ?? [] %}
            <link rel="stylesheet" href="{{ asset(css_asset) }}">
        {% endfor %}
    	#}
    {% endblock %}

    {% block head_javascript %}
	<script src="{{ asset('bundles/digitixframework/assets/theme.js') }}"></script>
    {% endblock head_javascript %}

    {#
    {% block configured_head_contents %}
        {% for htmlContent in ea.assets.headContents ?? [] %}
            {{ htmlContent|raw }}
        {% endfor %}
    {% endblock %}
    #}
</head>

{% block body %}
<body id="{{ entity_name }}">

	{% block header %}
	<header id="header">
		<nav class="nav-header">
			<div class="w-100 row justify-content-between align-items-center">
				<div class="col-auto">
					<a href="{{ path('dgtx_admin_entity_view', {entityName: 'dashboard'}) }}">
						<div class="logo"></div>
					</a>
				</div>
				<div class="col-auto">
					<div class="row align-items-center justify-content-center">
						<div class="col-auto">
							<a class="nav-header-links d-flex align-items-center" href="{{ path('dgtx_admin_entity_edit', {entityName: 'user', entityId: app.user.id}) }}">
								<i class="material-icons me-1">account_circle</i> {{ app.user.firstname|capitalize }} {{ app.user.lastname|capitalize }}
							</a>
						</div>
						<div class="col-auto">
							<a href="{{ app.request.getSchemeAndHttpHost() }}" target="_blank"><i class="material-icons">exit_to_app</i></a>
						</div>
						<div class="col-auto">
							<a href="{{ path('dgtx_admin_logout') }}">
								<i class="material-icons">power_settings_new</i>
							</a>
						</div>
					</div>
				</div>
			</div>
		</nav>
	</header>
	{% endblock %}

	{% block menu %}
		{% include '@DigitixFramework/admin/_partials/menu.twig' %}
	{% endblock %}

	{% block wrapper %}
	<div id="wrapper">
		{% block container %}
		<div id="wrapper-container">
			<div class="row">
				<div class="col">
					{% block notifications %}
					<div id="notifications-container" class="row">
						<div class="col">
							{% for label, messages in app.flashes %}
							    {% for message in messages %}
							        <div class="alert alert-{{ label }}" role="alert">
							            {{ message }}
							        </div>
							    {% endfor %}
							{% endfor %}
						</div>
					</div>
					{% endblock %}
					{% block infos_container%}
					<div id="infos-container" class="row">
						<div class="col">
							<div class="bg-white info-container">
								{% block infos %}{% endblock%}
							</div>
						</div>
					</div>
					{% endblock%}

					{% block content_header %}{% endblock %}

					{% block content_container %}
					<div class="row">
						<div class="col">
							{% block toolbar %}{% endblock %}
							<div class="bg-white mb-5 px-3 py-4">
								{% block content%}
									HTML HERE
								{% endblock%}
							</div>
						</div>
					</div>
					{% endblock%}
				</div>
			</div>
		</div>
		{% endblock %}
	</div>
	{% endblock %}

	{% block footer %}
	<footer id="footer">
		<div class="footer-container container-fluid">
			<div class="row justify-content-end">
				<div class="col">
					<a href="https://www.digitix.agency" class="copyright">
						<span>1.0.0</span>
						<img src="{{ asset('bundles/digitixframework/assets/images/logo-full.png') }}" />
					</a>
				</div>
			</div>
		</div>
	</footer>
	{% endblock %}
</body>
{% endblock %}
